# Application settings
DEBUG=false
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Source Database (for migration)
SOURCE_DB_URL=mysql://user:password@localhost:3306/source_db

# Encrypted Database (CLWE-secured data)
ENCRYPTED_DB_URL=mysql://user:password@localhost:3306/encrypted_db

# CLWE Encryption settings
CRYPTOPIX_DEFAULT_PASSWORD=your_secure_password_here
DEFAULT_SECURITY_LEVEL=Medium
TAG_SALT=your_tag_salt_here

# Security settings
SECRET_KEY=your_secret_key_here

# License server settings
LICENSE_SERVER_URL=https://bridge.cryptopix.in/api/bridge

# Performance settings
MAX_WORKERS=4
BATCH_SIZE=1000